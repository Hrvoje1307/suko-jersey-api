APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en

LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Supabase (Postgres) — koristi se samo eksplicitno preko --database=supabase.
# Vrijednosti: Supabase dashboard -> Project Settings -> Database -> Connection
# string -> Session pooler (port 5432, NE 6543).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# Baza nema sessions/cache/jobs tablice (vidi baseline) — drajveri ne smiju
# biti `database` dok se te tablice ne dodaju migracijom.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SHOP_ESTIMATED_DELIVERY_DAYS=21
SHOP_PRODUCTS_PER_PAGE=15
